# Engine environment variables — copy to .env and adjust. Never commit .env.
# Every variable has a working default; a bare `docker compose up` needs
# none of this file.

# ─── Postgres ───────────────────────────────────────────────────────
# SQLAlchemy URL with the `postgresql+psycopg` driver hint.
DATABASE_URL=postgresql+psycopg://noplag:noplag@localhost:5432/noplag

# Credentials for the docker-compose Postgres service.
# POSTGRES_USER=noplag
# POSTGRES_PASSWORD=noplag
# POSTGRES_DB=noplag
# ENGINE_PORT=8000

# ─── Object storage ─────────────────────────────────────────────────
# Local filesystem path for raw uploaded document bytes (the extracted
# text lives in Postgres; the original bytes are kept so documents can be
# re-extracted when the extractors improve). When unset, falls back to a
# system temp dir — fine for evaluation, not for durable storage.
# CORPUS_STORAGE_DIR=/var/lib/noplag/corpus

# ─── Sample corpus ──────────────────────────────────────────────────
# The container entrypoint loads the bundled Wikipedia sample corpus on
# first start so the demo has something to match against. Set to 0 when
# you bring your own corpus.
# NOPLAG_LOAD_SAMPLE_CORPUS=1

# ─── Checks ─────────────────────────────────────────────────────────
# Per-check retrieval time budget in seconds. A very large document that
# exceeds it returns partial (but uniform) coverage instead of hanging.
# NOPLAG_CHECK_BUDGET_S=60

# Single-tenant id every request runs as. Only override when layering
# your own multi-tenancy on top of the engine.
# NOPLAG_TENANT_ID=00000000-0000-4000-8000-000000000001

# ─── Fingerprint algorithm tuning ───────────────────────────────────
# k = k-gram size (characters) for winnowing; w = winnow window size in
# k-grams. Defaults are the tuned winners from the PAN-PC-11 sweep.
# Changing either requires re-fingerprinting the corpus — fingerprints
# only match when the corpus side and the query side agree.
# NOPLAG_FP_K=5
# NOPLAG_FP_W=8

# Chunk size in sentences, and the sentence overlap between adjacent
# chunks. Smaller chunks improve granularity but increase per-document
# storage.
# NOPLAG_CHUNK_SENTENCES=4
# NOPLAG_CHUNK_OVERLAP=1

# ─── L1 retrieval tuning (large corpora) ────────────────────────────
# These only matter once the corpus is large enough that you've built the
# fingerprint_df table (scripts/compute_fingerprint_df.py); see
# docs/self-hosting.md.
# NOPLAG_L1_DF_BUDGET=15000
# NOPLAG_L1_POOL_CAP=20000
# NOPLAG_L1_NONDISCRIM_DF=50000
# NOPLAG_STOP_LIST_N=1000

# ─── Alignment ──────────────────────────────────────────────────────
# Set to 0 to force single-process L0 alignment (tests, single-core
# boxes). Defaults to a process pool sized to the machine.
# NOPLAG_ALIGN_PARALLEL=1
