DB_NAME=postgres
DB_USER=postgres.project_ref
DB_PASSWORD=askfromASH
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=6543
DB_SCHEMA=fyp

# Supabase Storage (S3-compatible) — Project Settings > Storage > S3 Connection
SUPABASE_S3_ENDPOINT_URL=
SUPABASE_S3_REGION=ap-southeast-1
SUPABASE_S3_BUCKET=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=

# Shared password for the 20 fake author accounts created by
# `python manage.py seed_demo_data` — required to run that command.
SEED_DEMO_AUTHOR_PASSWORD=

# Contact address sent to OpenAlex on Discover requests (their "polite pool").
# Not a secret and not authentication — just identifies the deployment.
OPENALEX_MAILTO=you@example.org

# Django's built-in /admin/ site bypasses the API's rules and the audit log.
# Leave off except for local debugging.
DJANGO_ADMIN_ENABLED=False

# Gemini API key for the Author Assistant chatbot (apps/assistant).
# Free tier key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
